      "source": [
        "# Number Type\n",
        "# 1. Integer\n",
        "age = 25\n",
        "print (age)\n",
        "print (type(age))\n",
        "\n",
        "# 2. Float\n",
        "price = 99.50\n",
        "print(price)\n",
        "print(type(price))\n",
        "\n",
        "# 3. Complex\n",
        "z = 3 + 4j\n",
        "print(z)\n",
        "print (type(z))\n",
        "\n"
      ],
